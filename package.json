{
  "name": "md-master",
  "displayName": "MD Master",
  "description": "A Notion-style WYSIWYG editor for Markdown files. No syntax, just writing.",
  "version": "0.2.1",
  "publisher": "local",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdMaster.editor",
        "displayName": "MD Master",
        "selector": [
          {
            "filenamePattern": "*.md"
          },
          {
            "filenamePattern": "*.markdown"
          }
        ],
        "priority": {
          "textEditor": "default",
          "diffEditor": "default"
        }
      }
    ],
    "commands": [
      {
        "command": "mdMaster.openRaw",
        "title": "Open as Raw Markdown",
        "category": "MD Master",
        "icon": "$(code)"
      },
      {
        "command": "mdMaster.toggleOutline",
        "title": "Toggle Outline",
        "category": "MD Master",
        "icon": "$(list-tree)"
      },
      {
        "command": "mdMaster.export",
        "title": "Export…",
        "category": "MD Master",
        "icon": "$(export)"
      },
      {
        "command": "mdMaster.openEditor",
        "title": "Open in MD Master",
        "category": "MD Master",
        "icon": "$(edit)"
      }
    ],
    "keybindings": [
      {
        "command": "mdMaster.openRaw",
        "key": "ctrl+alt+e",
        "mac": "ctrl+cmd+e",
        "when": "activeCustomEditorId == mdMaster.editor"
      },
      {
        "command": "mdMaster.toggleOutline",
        "key": "ctrl+alt+o",
        "mac": "ctrl+cmd+o",
        "when": "activeCustomEditorId == mdMaster.editor"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdMaster.toggleOutline",
          "when": "activeCustomEditorId == mdMaster.editor",
          "group": "navigation@1"
        },
        {
          "command": "mdMaster.openRaw",
          "when": "activeCustomEditorId == mdMaster.editor",
          "group": "navigation@2"
        },
        {
          "command": "mdMaster.export",
          "when": "activeCustomEditorId == mdMaster.editor",
          "group": "navigation@3"
        },
        {
          "command": "mdMaster.openEditor",
          "when": "editorLangId == markdown && !activeCustomEditorId",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "mdMaster.openRaw",
          "when": "resourceExtname == .md",
          "group": "navigation@99"
        }
      ],
      "commandPalette": [
        {
          "command": "mdMaster.toggleOutline",
          "when": "activeCustomEditorId == mdMaster.editor"
        },
        {
          "command": "mdMaster.export",
          "when": "activeCustomEditorId == mdMaster.editor"
        }
      ]
    },
    "configuration": {
      "title": "MD Master",
      "properties": {
        "mdMaster.maxWidth": {
          "type": "number",
          "default": 760,
          "description": "Maximum width (px) of the writing column."
        },
        "mdMaster.fontFamily": {
          "type": "string",
          "default": "",
          "description": "Font family for the editor. Leave empty for the Notion-style default system font."
        },
        "mdMaster.fontSize": {
          "type": "number",
          "default": 16,
          "description": "Base font size (px)."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "package": "npm run build -- --production && vsce package --no-dependencies --allow-missing-repository --skip-license",
    "install-ext": "npm run package && \"/Applications/Visual Studio Code.app/Contents/Resources/app/bin/code\" --install-extension md-master-$npm_package_version.vsix --force"
  },
  "devDependencies": {
    "@tiptap/core": "^3.34.0",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/extension-list": "^3.34.0",
    "@tiptap/extension-table": "^3.34.0",
    "@tiptap/extension-text": "^3.34.0",
    "@tiptap/extensions": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "1.93.0",
    "@vscode/vsce": "^3.9.2",
    "diff": "^9.0.0",
    "esbuild": "^0.28.2",
    "prosemirror-markdown": "^1.13.9",
    "tiptap-extension-global-drag-handle": "^0.1.18",
    "tiptap-markdown": "^0.9.0",
    "typescript": "^5.6.3"
  },
  "enabledApiProposals": [
    "customEditorDiffs"
  ]
}
